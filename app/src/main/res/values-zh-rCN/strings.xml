    <string name="settings_keep_notification_after_disconnect_label">断开连接后保留通知</string>
    <string name="settings_keep_notification_after_disconnect_description">AirPods 断开连接后，继续显示上次获取的电量。</string>
    <string name="settings_monitor_statusbar_battery_label">状态栏显示电量</string>
    <string name="settings_monitor_statusbar_battery_description">将电量百分比显示为状态栏通知图标。对于两只耳机，显示未充电耳机中电量较低的一只。</string>
    <string name="settings_autopause_label">自动暂停</string>
    <string name="settings_autopause_description">摘下耳机时暂停音频。</string>
    <string name="settings_autopplay_label">自动播放</string>
    <string name="settings_autoplay_description">重新戴上耳机时恢复播放，但仅限于此前由“自动暂停”暂停的音频。你手动暂停的音频（通过手机、AirPods 耳机柄或睡眠模式）会保持暂停。</string>
    <string name="settings_start_music_on_wear_label">戴上耳机时播放音乐</string>
    <string name="settings_start_music_on_wear_description">每次戴上耳机都尝试播放音乐，即使此前曾手动暂停。</string>
    <string name="settings_eardetection_info_description">如果佩戴检测只对一只耳机有效，这是 Apple 的限制。系统只能检测作为麦克风使用的“主耳机”。可在 Apple 设备的“设置 → 蓝牙 → AirPods → 麦克风”中配置。</string>
    <string name="settings_autoconnect_label">自动连接</string>
    <string name="settings_autoconnect_description">仅在身份已验证、广播状态新鲜且其他设备空闲时请求连接。开启后保持后台监测，系统需允许应用发起蓝牙音频连接。</string>
    <string name="settings_autoconnect_info_android12">自动连接依赖一项系统功能，Android 12 及更高版本会限制该功能，因此可能无法在你的设备上使用。</string>
