    <string name="head_action_volume_up">调高音量</string>
    <string name="head_action_volume_down">调低音量</string>
    <string name="settings_monitor_idle_notification_label">显示后台常驻通知</string>
    <string name="settings_monitor_idle_notification_description">关闭后，“准备好自动连接”通知会移入静默折叠频道，不在状态栏显示图标。Android 要求后台监测必须保留一条通知，因此无法完全移除。</string>
    <string name="notification_channel_device_status_quiet_label">后台监测（静默）</string>
    <string name="settings_sleep_detection_confirm_info">为避免误暂停，只有在佩戴耳机且耳机在数分钟内多次报告入睡时才会暂停。</string>
    <string name="noise_control_waiting_system">已识别该型号支持降噪，但耳机尚未连接手机。</string>
    <string name="noise_control_waiting_channel">已连接，正在建立高级控制通道…</string>
    <string name="noise_control_waiting_state">控制通道已就绪，正在等待耳机回报当前模式…</string>
    <string name="noise_control_channel_failed">高级控制通道未能建立，请尝试故障排查或重新连接耳机。</string>
    <string name="device_match_issue_title">广播未关联到配置</string>
    <string name="device_match_issue_no_profiles">附近有兼容的耳机广播，但没有匹配的配置。请在设备管理中添加这副耳机。</string>
    <string name="device_match_issue_ambiguous">有多副同型号且无密钥的配置，无法安全判断这条广播属于哪一副。请绑定系统配对地址，或删除重复配置。</string>
    <string name="device_match_issue_key_unresolved">该配置有身份密钥，但密钥无法验证这条广播。请检查配对地址或重新获取密钥。</string>
    <string name="device_match_issue_model_mismatch">广播的型号与配置不一致。请重新选择配对设备或修正型号。</string>
    <string name="adaptive_noise_strength_label">自适应音频强度</string>
    <string name="adaptive_noise_strength_description" formatted="false">在降噪与通透之间无级调节（0% 更偏通透，100% 降噪更强）。</string>
