<?xml version='1.0' encoding='utf-8'?>
<resources>
    <string name="head_gestures_title">头部手势</string>
    <string name="head_gestures_description">戴好耳机后使用点头和摇头操作。首次使用请保持头部稳定。</string>
    <string name="head_gestures_calls">来电接听与拒接</string>
    <string name="head_gestures_calls_description">点头接听，摇头拒接。需要电话状态和接听电话权限。</string>
    <string name="head_gestures_media">自定义音乐控制</string>
    <string name="head_gestures_media_description">无通话时连续两次点头或摇头触发音乐控制（第 1 次会有轻提示音，3 秒内完成第 2 次即触发）。</string>
    <string name="head_gestures_nod">连续两次点头操作</string>
    <string name="head_gestures_shake">连续两次摇头操作</string>
    <string name="head_gestures_sensitivity">动作阈值（数值越小越灵敏）</string>
    <string name="head_action_none">不执行</string>
    <string name="head_action_play_pause">播放／暂停</string>
    <string name="head_action_next">下一首</string>
    <string name="head_action_previous">上一首</string>
    <string name="head_action_volume_up">调高音量</string>
    <string name="head_action_volume_down">调低音量</string>
    <string name="settings_monitor_idle_notification_label">显示后台常驻通知</string>
    <string name="settings_monitor_idle_notification_description">关闭后，“准备好自动连接”通知会移入静默折叠频道，不在状态栏显示图标。Android 要求后台监测必须保留一条通知，因此无法完全移除。</string>
    <string name="notification_channel_device_status_quiet_label">后台监测（静默）</string>
    <string name="settings_sleep_detection_confirm_info">为避免误暂停，只有在佩戴耳机且耳机在数分钟内多次报告入睡时才会暂停。</string>
</resources>